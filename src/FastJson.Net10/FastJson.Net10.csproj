<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>FastJson.Net10</AssemblyName>
    <RootNamespace>FastJson</RootNamespace>
    <PackageId>FastJson.Net10</PackageId>
    <Version>1.0.0</Version>
    <Description>High-performance, source-generated System.Text.Json import, export, serialization, and C# model generation for .NET 10.</Description>
    <Authors>FastJson.Net10 contributors</Authors>
    <PackageTags>json;system.text.json;source-generator;serialization;performance</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>
</Project>
